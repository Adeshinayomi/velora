# Required in every environment
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Comma-separated browser origins. Include protocol, no trailing slash.
# For production, include every deployed frontend domain and omit localhost.
FRONTEND_URLS=http://localhost:3000,https://your-store.example

# Optional server settings
PORT=5000
NODE_ENV=development
DNS_SERVERS=8.8.8.8,1.1.1.1
SHIPPING_FEE=0
CURRENCY=NGN

# Required for payment flows
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://your-store.example/checkout/complete

# Required for product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when running promote:admin
ADMIN_EMAIL=
